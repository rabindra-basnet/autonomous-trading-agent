# PostgreSQL Database (use the local container from podman-compose.yml)
DATABASE_URL=postgresql+asyncpg://tradepulse:tradepulse@localhost:5432/tradepulse?sslmode=disable

# DuckDB Local Analytical Storage
DUCKDB_PATH=data/trading_agent.duckdb

# Redis Streams Event Bus (use the local container from podman-compose.yml)
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=redis_streams

# ======================================================================
# Universal OpenAI-Compatible LLM Configuration
# Works seamlessly with:
# - Groq Free Tier (https://api.groq.com/openai/v1)
# - OpenRouter Free Tier (https://openrouter.ai/api/v1)
# - Ollama Local (http://localhost:11434/v1)
# - Gemini OpenAI Endpoint (https://generativelanguage.googleapis.com/v1beta/openai/)
# - DeepSeek, vLLM, LM Studio, etc.
# ======================================================================
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_free_key_here
OPENAI_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------
# Optional LLM token cost accounting (USD per 1M tokens).
# Set to your provider's rate to have per-call costs persisted to the
# `llm_usage` table. Per-model overrides (JSON) win over the flat prices.
# ----------------------------------------------------------------------
# OPENAI_INPUT_PRICE_PER_1M=0.0
# OPENAI_OUTPUT_PRICE_PER_1M=0.0
# OPENAI_MODEL_PRICES={"my-model": {"input_per_1m": 0.14, "output_per_1m": 0.28}}

# ======================================================================
# Live Data-Provider Keys
# Market/news/social/onchain sources are keyless. FRED is optional: set it
# to get macro regime features, otherwise those features are simply absent.
# ======================================================================
FRED_API_KEY=