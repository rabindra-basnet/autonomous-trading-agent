# PostgreSQL Database (Neon)
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname?sslmode=require

# DuckDB Local Analytical Storage
DUCKDB_PATH=data/trading_agent.duckdb

# Redis / Upstash Event Bus
REDIS_URL=rediss://default:password@host:6379
EVENT_BUS=redis_streams

# ======================================================================
# Universal OpenAI-Compatible LLM Configuration
# Works seamlessly with:
# - Groq Free Tier (https://api.groq.com/openai/v1)
# - OpenRouter Free Tier (https://openrouter.ai/api/v1)
# - Ollama Local (http://localhost:11434/v1)
# - Gemini OpenAI Endpoint (https://generativelanguage.googleapis.com/v1beta/openai/)
# - DeepSeek, vLLM, LM Studio, etc.
# ======================================================================
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_free_key_here
OPENAI_MODEL=llama-3.3-70b-versatile
